generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model delay_predictions {
  id              String   @id @default(uuid())
  airport_code    String
  created_at      DateTime @default(now())
  prediction_data Json
}

model queue_metrics {
  id           String   @id @default(uuid())
  airport_code String
  created_at   DateTime @default(now())
  metrics_data Json
}
